{
  "name": "emotional-voice-assistant",
  "version": "1.0.0",
  "description": "Voice assistant with emotional tone detection and response",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client-nextjs && npm run dev",
    "dev:client": "cd client-nextjs && npm run dev",
    "client:legacy": "cd client && npm start",
    "dev:legacy": "cd client && npm run dev",
    "install:client": "cd client-nextjs && npm install",
    "install:legacy": "cd client && npm install",
    "build": "cd client-nextjs && npm run build",
    "build:legacy": "cd client && npm run build",
    "setup": "npm install && cd client-nextjs && npm install && cd ..",
    "setup:legacy": "npm install && cd client && npm install && cd ..",
    "start:both": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "start:legacy": "concurrently \"npm run dev\" \"npm run dev:legacy\""
  },
  "dependencies": {
    "axios": "^1.6.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.20.1",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "voice",
    "assistant",
    "emotion",
    "ai",
    "speech"
  ],
  "author": "",
  "license": "MIT"
}
